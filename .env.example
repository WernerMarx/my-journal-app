# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# --- Which settings module to load ---
DJANGO_SETTINGS_MODULE=config.settings.development

# --- Core Django ---
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=dev-only-insecure-change-me-0123456789abcdef0123456789
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (psycopg 3 / PostgreSQL) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://postgres:postgres@db:5432/app

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://redis:6379/0

# --- CORS (comma-separated origins the React SPA is served from) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Email (console backend in dev; SMTP in prod) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Error monitoring (production only; leave blank to disable Sentry) ---
SENTRY_DSN=
